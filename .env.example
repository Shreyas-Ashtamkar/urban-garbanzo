# Environment Variables Template
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/urban_garbanzo

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Application
APP_NAME=urban-garbanzo
APP_VERSION=0.1.0
LOG_LEVEL=INFO

